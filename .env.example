# Fort backend environment (cp .env.example .env)

# --- Application ---
APP_NAME=Fort Security SaaS
DEBUG=false
APP_PORT=8000

# --- Database ---
# Для локального запуска без Docker (PostgreSQL на localhost).
# В docker-compose DATABASE_URL собирается автоматически из POSTGRES_*.
DATABASE_URL=postgresql+asyncpg://fort:fort@localhost:5432/fort
POSTGRES_USER=fort
POSTGRES_PASSWORD=fort
POSTGRES_DB=fort
POSTGRES_PORT=5432

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Superadmin (создаётся скриптом scripts/seed.py) ---
SUPERADMIN_EMAIL=admin@fort.local
SUPERADMIN_PASSWORD=change-me-too
